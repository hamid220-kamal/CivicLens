# ==========================================
# CivicLens Environment Configuration Template
# ==========================================
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or any real secrets to Git.

# --- SUPABASE (Database, Auth, Storage) ---
# Project URL (Browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable/Anon API Key (Browser-safe, read/write subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key (SERVER-SIDE ONLY - never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- GOOGLE GEMINI AI (Vision, Triage, RAG & Embeddings) ---
# Gemini API Key (SERVER-SIDE ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional legacy alias if referenced by scripts
LLM_API_KEY=your_gemini_api_key_here

# Model specifications
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

